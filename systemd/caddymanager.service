[Unit]
Description=CaddyManager stack orchestrator
After=podman.service caddy.service tailscaled.service caddymanager-backend.service caddymanager-frontend.service
Requires=podman.service caddy.service tailscaled.service
Wants=podman.service caddy.service tailscaled.service caddymanager-backend.service caddymanager-frontend.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/bin/true
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
