# Backend runtime environment (SQLite only)
# Copy to /etc/caddy/manager/backend.env for quadlet units.

PORT=3000
NODE_ENV=production

# Database
DB_ENGINE=sqlite
SQLITE_DB_PATH=/app/data/caddymanager.sqlite

# Security
# Generate a strong secret with:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
JWT_EXPIRES_IN=24h

# API security / frontend origin
CORS_ORIGIN=http://localhost

# Caddy convert/sandbox fallback URL
CADDY_SANDBOX_URL=http://localhost:2019

# Health monitor
PING_INTERVAL=30000
PING_TIMEOUT=2000

# Metrics history size (number of in-memory snapshots)
METRICS_HISTORY_MAX=1000
