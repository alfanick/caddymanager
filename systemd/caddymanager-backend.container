[Unit]
Description=CaddyManager backend API container
After=network-online.target podman.service caddymanager.network
Wants=podman.service caddymanager.network
PartOf=caddymanager.service

[Container]
ContainerName=caddymanager-backend
Image=docker.io/caddymanager/caddymanager-backend:latest
# Send container stdout/stderr to journald
LogDriver=journald
# Expose backend on high host loopback port for local-only access while keeping
# container port 3000 internal.
PublishPort=127.0.0.1:12000:3000
# Public build from registry. For dev builds later, switch to a local dev image.
# e.g. Image=localhost/caddymanager-backend:dev
# or use a paired .build file and set Image=caddymanager-backend.build
Network=caddymanager.network
Volume=/etc/caddy/manager:/app/data:Z,U

EnvironmentFile=/etc/caddy/manager/backend.env

[Service]
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5s
StartLimitIntervalSec=120s
StartLimitBurst=6

[Install]
WantedBy=multi-user.target
