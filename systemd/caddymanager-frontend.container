[Unit]
Description=CaddyManager frontend container
After=network-online.target podman.service caddymanager.network caddymanager-backend.service
Wants=podman.service caddymanager.network caddymanager-backend.service
PartOf=caddymanager.service
StartLimitIntervalSec=120s
StartLimitBurst=6

[Container]
ContainerName=caddymanager-frontend
Image=localhost/caddymanager-frontend:dev
# Send container stdout/stderr to journald
LogDriver=journald

EnvironmentFile=/etc/caddy/manager/frontend.env

# Host port changed to avoid collisions with host Caddy on 80.
# Caddy should proxy to this loopback host port (for example http://127.0.0.1:12001).
PublishPort=127.0.0.1:12001:80
Network=caddymanager.network

[Service]
StandardOutput=journal
StandardError=journal
ExecStartPre=/usr/bin/podman build --rm -t localhost/caddymanager-frontend:dev /home/alfanick/Projects/caddymanager/frontend
Restart=always
RestartSec=5s
