# Frontend runtime/build environment (Vite + runtime /config)
# Copy to /etc/caddy/manager/frontend.env for quadlet units.

# Frontend <-> backend proxy target used by embedded Caddyfile
BACKEND_HOST=caddymanager-backend:3000

# Frontend UI config injected into /config
APP_NAME=Caddy Manager
DARK_MODE=true

# Vite fallback env vars (used when /config is not available)
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=Caddy Manager
VITE_ENABLE_DARK_MODE=true
